{
  "expo": {
    "name": "Billet",
    "slug": "billet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "billet",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false,
          "cameraPermission": "Allow Billet to photograph receipts and expense moments.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Billet to choose receipt photos from your library."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Billet to use Face ID to unlock your private expense journal."
        }
      ],
      [
        "expo-share-intent",
        {
          "iosActivationRules": {
            "NSExtensionActivationSupportsImageWithMaxCount": 1
          },
          "iosAppGroupIdentifier": "group.vn.devt.billet",
          "iosShareExtensionBundleIdentifier": "vn.devt.billet.share-extension",
          "androidIntentFilters": ["image/*"],
          "androidMainActivityAttributes": {
            "android:launchMode": "singleTask"
          }
        }
      ],
      "./plugins/with-share-history-guard",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Billet uses your location only while you use the app, to fill in where you spent and to recognize places where you often spend.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "locationFullAccuracyPermission": false,
          "motionUsagePermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "baseUrl": "/expo",
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "vn.devt.billet"
    },
    "android": {
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "package": "vn.devt.billet"
    }
  }
}
