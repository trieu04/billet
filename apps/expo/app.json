{
  "expo": {
    "name": "Billet",
    "slug": "billet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "billet",
    "userInterfaceStyle": "automatic",
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "barcodeScannerEnabled": false,
          "cameraPermission": "Allow Billet to photograph receipts and expense moments.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Billet to choose receipt photos from your library."
        }
      ],
      "expo-font",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Billet to use Face ID to unlock your private expense journal."
        }
      ],
      "expo-status-bar",
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "experiments": {
      "baseUrl": "/expo",
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "app.billet.mobile"
    },
    "android": {
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "package": "app.billet.mobile"
    }
  }
}
