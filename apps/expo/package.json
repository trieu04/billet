{
  "name": "@billet/expo",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 6703",
    "start": "expo start --port 6703",
    "android": "expo start --android --port 6703",
    "ios": "expo start --ios --port 6703",
    "web": "expo start --web --port 6703",
    "build": "expo export --platform web --output-dir dist",
