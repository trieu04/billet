# Runtime
NODE_ENV=development
SERVER_HOST=0.0.0.0
SERVER_PORT=6701

# HTTP API and browser access
API_PATH_PREFIX=api/v1
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:6702

# Comma-separated user ids allowed to use /admin; empty means nobody. Changes need a restart.
ADMIN_USER_IDS=

# OpenAPI documentation
OPENAPI_ENABLED=true
OPENAPI_PATH=docs

# PostgreSQL
DATABASE_HOST=localhost
DATABASE_PORT=6710
DATABASE_USERNAME=billet
DATABASE_PASSWORD=billet
DATABASE_NAME=billet
DATABASE_SSL_ENABLED=false

# Authentication and registration
AUTH_JWT_SECRET=development-only-change-me
AUTH_ACCESS_TOKEN_TTL=15m
AUTH_REFRESH_TOKEN_TTL=30d
AUTH_REGISTRATION_VERIFICATION_POLICY=one_of

# Social sign-in audiences (comma-separated client IDs for shipped clients)
AUTH_GOOGLE_OIDC_CLIENT_IDS=
AUTH_APPLE_OIDC_CLIENT_IDS=

# Email delivery (SMTP)
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_TLS_ENABLED=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=

# SMS delivery (generic HTTP provider)
SMS_HTTP_PROVIDER_ENABLED=false
SMS_HTTP_PROVIDER_URL=
SMS_HTTP_PROVIDER_TOKEN=
SMS_SENDER_NAME=Billet
SMS_HTTP_TIMEOUT_MS=10000

# Realtime WebSocket transport
REALTIME_WEBSOCKET_PATH=/ws
REALTIME_WEBSOCKET_ALLOWED_ORIGINS=http://localhost:6702

# Firebase Cloud Messaging service account
FCM_ENABLED=false
FCM_SERVICE_ACCOUNT_FILE=

# Local object storage
LOCAL_OBJECT_STORAGE_DIRECTORY=data/sample/object-storage

# Media uploads (bytes)
MEDIA_MAX_FILE_SIZE_BYTES=15000000

# Photo expense suggestion (decision provider)
# disabled | fake (non-production only) | google-ai-studio | openai-compatible
EXPENSE_DECISION_PROVIDER=disabled
EXPENSE_DECISION_MODEL=
# openai-compatible: base URL of a Chat Completions API (for example https://host/v1) and its key
EXPENSE_DECISION_BASE_URL=
EXPENSE_DECISION_API_KEY=
# google-ai-studio: comma-separated key pool, rotated per request and on HTTP 429
EXPENSE_DECISION_GOOGLE_API_KEYS=
# Hard provider timeout (500-30000 ms) and maximum compressed image size (bytes)
EXPENSE_DECISION_TIMEOUT_MS=5000
EXPENSE_DECISION_MAX_IMAGE_BYTES=1048576
