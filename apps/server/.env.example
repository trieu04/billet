NODE_ENV=development
HOST=0.0.0.0
PORT=6701
API_PREFIX=api/v1
API_DOCS_ENABLED=true
API_DOCS_PATH=docs
CORS_ORIGINS=http://localhost:6702
DB_HOST=localhost
DB_PORT=6710
DB_USERNAME=billet
DB_PASSWORD=billet
DB_NAME=billet
DB_SSL=false
JWT_SECRET=development-only-change-me
JWT_ACCESS_TOKEN_TTL=15m
AUTH_REGISTRATION_VERIFICATION_POLICY=one_of
# Comma-separated OAuth audiences (web, iOS, Android client IDs as applicable).
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=
EMAIL_ENABLED=false
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=
SMS_ENABLED=false
SMS_PROVIDER_URL=
SMS_API_TOKEN=
SMS_SENDER=Billet
SMS_TIMEOUT_MS=10000
WS_PATH=/ws
WS_ALLOWED_ORIGINS=http://localhost:6702
FIREBASE_ENABLED=false
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
OBJECT_STORAGE_PATH=data/sample/object-storage
RECOGNITION_PROVIDER=disabled
# One key or comma-separated round-robin keys. Limits below are totals for the whole pool.
GOOGLE_AI_STUDIO_API_KEYS=
GOOGLE_AI_STUDIO_MODEL=gemini-2.5-flash
RECOGNITION_TIMEOUT_MS=30000
RECOGNITION_RPM=10
RECOGNITION_TPM=250000
RECOGNITION_RPD=250
RECOGNITION_ESTIMATED_TOKENS=4096
