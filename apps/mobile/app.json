{
  "expo": {
    "name": "Billet",
    "slug": "billet",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "billet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "plugins": ["expo-router"],
    "experiments": { "typedRoutes": true },
    "web": { "bundler": "metro", "output": "static" },
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.billet.mobile" },
    "android": { "package": "app.billet.mobile" }
  }
}
