{
  "name": "@billet/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --port 6702",
    "start": "expo start --port 6702",
    "android": "expo start --android --port 6702",
    "ios": "expo start --ios --port 6702",
    "web": "expo start --web --port 6702",
    "build": "expo export --platform web --output-dir dist",
    "lint": "oxlint app features",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~54.0.12",
    "expo-constants": "~18.0.9",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.10",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-safe-area-context": "~5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "oxlint": "^1.81.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
