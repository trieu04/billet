# Mobile app environment (optional overrides)
# EXPO_PUBLIC_* vars are inlined into the client bundle at build time.
#
# Base URL of the backend API. Defaults to the LAN IP baked into src/config.ts.
# Override here to point at a different host. Use your machine's LAN IP (not
# localhost) so a physical device / emulator on the same network can reach it.
# Android emulator alternative: http://10.0.2.2:4000
EXPO_PUBLIC_API_URL=http://192.168.88.243:4000
