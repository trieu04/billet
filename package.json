{
  "name": "billet",
  "version": "0.1.0",
  "private": true,
  "description": "Billet — a visual expense journal.",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "pnpm --parallel --stream -r dev",
    "dev:server": "pnpm --filter @billet/server dev",
    "dev:web": "pnpm --filter @billet/web dev",
    "dev:expo": "pnpm --dir apps/expo dev",
    "changeset": "changeset",
    "release:check": "changeset status",
    "release:version": "changeset version",
    "build": "pnpm --workspace-concurrency=1 -r build",
    "lint": "pnpm --workspace-concurrency=1 -r lint",
    "typecheck": "pnpm --workspace-concurrency=1 -r typecheck",
    "test": "pnpm --workspace-concurrency=1 -r test",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "oxfmt": "^0.73.0"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.8.1"
}
